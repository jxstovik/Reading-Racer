    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.7.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "main": "desktop/main.cjs",
  "author": {
